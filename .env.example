# File: .env.example
# Description:
#   Environment Variables Specification Template for JibuTax.
#   Copy this file to `.env` and populate your secrets locally. Never commit `.env`!

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL Database Credentials
POSTGRES_USER=jibutax
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=jibutax_db
DATABASE_URL=postgresql://jibutax:your_secure_password_here@localhost:5432/jibutax_db

# Redis / Celery (Render injects REDIS_URL from jibutax-redis)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# KRA eTIMS + TOT / NIL filing
KRA_ENVIRONMENT=sandbox
KRA_BASE_URL=https://sbx.kra.go.ke
KRA_API_TOKEN=
KRA_TOT_PATH=/filing/v1/tot/paymentregistration
KRA_NIL_PATH=/dtd/return/v1/nil
KRA_OSCU_DEVICE_ID=OSCU-KE-NBO-0042
TOT_RATE=0.015
NIL_OBLIGATION_CODE=7
DEFAULT_TRADER_PIN=A012345678W
DEFAULT_TRADER_NAME=JibuTax Demo Trader

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
WEBHOOK_SECRET=your_webhook_secret_token_here

# SMS Notification Gateway (Africa's Talking / Twilio / Mock)
SMS_PROVIDER=mock
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
