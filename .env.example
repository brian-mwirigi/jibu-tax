# File: .env.example
# Description:
#   Environment Variables Specification Template for JibuTax.

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database — sqlite is enough for local Postman tests. Docker/Render override this to Postgres.
DATABASE_URL=sqlite:///./jibutax.db

# KRA eTIMS Configuration
KRA_ENVIRONMENT=sandbox
KRA_OSCU_DEVICE_ID=OSCU-KE-NBO-0042
OSCU_SIGNING_SECRET=jibutax-oscu-demo-secret-change-me
DEFAULT_TRADER_PIN=A012345678W
DEFAULT_TRADER_NAME=JibuTax Demo Trader
PUBLIC_BASE_URL=http://localhost:8000

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
WEBHOOK_SECRET=jibutax_secret_token_2026

# SMS Notification Gateway (Africa's Talking / Twilio / Mock)
SMS_PROVIDER=mock
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# WhatsApp QR delivery
# Stay on mock. Do not set WHATSAPP_PROVIDER to twilio — Twilio WhatsApp
# consumes trial credits and the free trial cannot send a custom QR image.
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=jibutax_whatsapp_verify

# Optional, free Meta *test* number only (no payment method):
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started/
# If Meta asks for a credit card, billing, or a live business number: stop and keep mock.
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v21.0

# Leave empty. Twilio WhatsApp is not used (credits / paid).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
