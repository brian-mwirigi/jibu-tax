              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('whatsapp resend', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().whatsapp_status).to.be.oneOf(['mocked', 'sent', 'skipped_not_configured', 'skipped_public_url_required', 'failed']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/invoices/{{invoice_number}}/whatsapp"
          }
        },
        {
          "name": "Verify unknown control code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('not found, valid false', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().valid).to.eql(false);",
                  "  pm.expect(pm.response.json().invoice).to.eql(null);",
                  "});"
