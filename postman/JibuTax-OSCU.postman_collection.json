    {
      "name": "2. File invoices (seal + mocked SMS)",
      "item": [
        {
          "name": "File Safari Builders cement (demo sale)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('filed 200', () => pm.response.to.have.status(200));",
                  "pm.test('totals + mocked SMS + WhatsApp', function () {",
                  "  pm.expect(Number(json.grand_total)).to.eql(232000);",
                  "  pm.expect(json.sms_status).to.eql('mocked');",
                  "  pm.expect(json.sms_destination).to.eql('+254712345678');",
                  "  pm.expect(json.whatsapp_status).to.eql('mocked');",
                  "  pm.expect(json.whatsapp_destination).to.eql('+254712345678');",
                  "  pm.expect(json.oscu_control_code).to.match(/^[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}$/);",
                  "  pm.expect(json.qr_code_base64).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.signature_valid).to.eql(true);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('invoice_number', json.invoice_number);",
                  "  pm.collectionVariables.set('control_code', json.oscu_control_code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trader_pin\": \"A012345678W\",\n  \"trader_name\": \"JibuTax Demo Trader\",\n  \"trader_phone\": \"0712345678\",\n  \"buyer_pin\": \"P051234567M\",\n  \"buyer_name\": \"Safari Builders\",\n  \"send_sms\": true,\n  \"items\": [\n    {\n      \"description\": \"bags of cement\",\n      \"quantity\": 100,\n      \"unit_price\": 2000\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/invoices"
          }
        },
        {
          "name": "File walk-in (no buyer PIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
