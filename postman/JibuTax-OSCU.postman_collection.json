          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trader_phone\": \"0712345678\",\n  \"send_sms\": true,\n  \"items\": [\n    {\n      \"description\": \"bags of cement\",\n      \"quantity\": 2,\n      \"unit_price\": 2000\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/invoices"
          }
        },
